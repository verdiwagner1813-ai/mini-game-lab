{
  "id": "exhibit-mission",
  "title": "展示室の並び替えミッション",
  "source": "experiments/exhibit-seven-days/day-02-final/game.html",
  "purpose": "3つの公開条件を3人で相談して統合し、仮説と検証で展示配置を見つける",
  "target_age": "小学校4〜6年生・3人で1台。性別による好みの決めつけをしない",
  "basic_rules": [
    "4作品・3条件、練習1問と本番2問",
    "全条件で一意解、3条件すべて必要",
    "担当交代、ヒント、パス、1手もどす",
    "約5分の目安、勝敗や誤答罰なし"
  ],
  "forbidden_changes": [
    "元版・過去完成版の編集削除",
    "個人情報・通信・外部依存・ログイン・音点滅の追加",
    "基本ルールや教育目的の変更",
    "テストや設定を変更して合格させること"
  ],
  "browser_contract": {
    "start_selector": "#start",
    "action_selector": "[data-slot=\"0\"]"
  },
  "specific_tests": [
    {
      "id": "exhibit-independent-logic",
      "command": [
        "node",
        "tests/day2-acceptance-logic.cjs",
        "{candidate}"
      ]
    },
    {
      "id": "exhibit-full-browser",
      "command": [
        "node",
        "tests/day2-acceptance-browser.cjs",
        "{candidate}"
      ]
    },
    {
      "id": "exhibit-highlight",
      "command": [
        "node",
        "engine-v1/tests/improvement-specific.cjs",
        "{candidate}",
        "exhibit-highlight"
      ]
    }
  ]
}
